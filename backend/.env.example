# ====================================================================
# Backend Environment Template (.env.example)
# Copy this file to .env for local bare-metal / nodemon development
# ====================================================================

# Port for Express API server
PORT=5000

# MongoDB URI Options:
# 1. Local MongoDB (Windows Service / mongod):
MONGODB_URI=mongodb://127.0.0.1:27017/student_mgmt_exp10_dev

# 2. Docker Compose (when running inside backend container):
# MONGODB_URI=mongodb://mongodb:27017/student_mgmt_docker_db

# 3. Production MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/student_mgmt_prod?retryWrites=true&w=majority

# Client Application URL for CORS origin validation
CLIENT_URL=http://localhost:5173

# Application environment: development | production | test
NODE_ENV=development
