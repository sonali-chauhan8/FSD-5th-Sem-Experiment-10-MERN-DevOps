# ====================================================================
# Docker Compose Root Environment Configuration Template (.env.example)
# Copy this file to .env before running 'docker compose up'
# ====================================================================

# Port mapping on host machine
FRONTEND_PORT=8080
BACKEND_PORT=5001
MONGODB_PORT=27018

# Docker internal MongoDB URI (uses Docker service name 'mongodb')
MONGODB_URI=mongodb://mongodb:27017/student_mgmt_docker_db
MONGO_INITDB_DATABASE=student_mgmt_docker_db

# Allowed origin for CORS in Docker
CLIENT_URL=http://localhost:8080

# Environment mode
NODE_ENV=production
