# ====================================================================
# Frontend Environment Template (.env.example)
# Note: Frontend NEVER receives or stores MongoDB credentials!
# ====================================================================

# Base URL of Express backend API
# Local dev: http://localhost:5000/api
# In Docker (via Nginx reverse proxy): /api
# In production: https://your-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api
